# Copy these into your shell, or add them as Environment Variables on Vercel.
# NEVER commit real keys.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Optional LLM summary polish. Groq is used first if its key is set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

LLM_TIMEOUT=8

# Only needed when the frontend lives on another site (for example Firebase Hosting).
# Comma separated, no trailing slash.
ALLOWED_ORIGINS=

# Optional LangSmith tracing (https://smith.langchain.com). Needs the langsmith package.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=globepath-study-abroad-agent
# Use false on Vercel so traces are sent before the function stops.
LANGSMITH_TRACING_BACKGROUND=false
